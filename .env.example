APP_ENV=development
PORT=8080
DATABASE_URL=root:contentloop@tcp(mysql:3306)/content_loop?parseTime=true&multiStatements=true&charset=utf8mb4
MYSQL_ROOT_PASSWORD=contentloop
MYSQL_DATABASE=content_loop
MYSQL_USER=contentloop
MYSQL_PASSWORD=contentloop
MIGRATIONS_DIR=file://migrations

# Auth (Google OAuth — см. ниже как получить)
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
JWT_SECRET=change-me-to-random-32-chars
NEXT_PUBLIC_GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com

# AI (global, opencode-go gateway)
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=changeme
AI_MODEL=kimi-k2.5

# FamilyOS adapter
FAMILYOS_BASE_URL=https://pattayadom.example.com
FAMILYOS_API_KEY=changeme

# Telegram adapter
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHANNEL_ID=@changeme
